<footer class="bg-ink text-paper">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="display text-4xl">Dératis</p>
      <p class="mt-3 max-w-sm text-paper/75">Dératisation, désinsectisation et destruction de nids dans le Gard, la Lozère et l'Ardèche, depuis 2006.</p>
      <div class="mt-6 flex items-center gap-4">
        <img src="<%= public_path("images/ministere-ecologie.png") %>" alt="Ministère de l'Écologie" width="54" height="69" class="rounded-sm bg-plate p-1">
        <p class="text-sm text-paper/75">Agrément ministériel.<br>Tous nos intervenants sont certifiés Certibiocide.</p>
      </div>
    </div>

    <div>
      <p class="mb-3 font-bold">Nous joindre</p>
      <ul class="space-y-2 text-paper/85">
        <li><a href="<%= deratis_phone_uri() %>" class="font-bold text-wasp no-underline hover:underline"><%= deratis_phone() %></a></li>
        <li><a href="mailto:<%= deratis_email() %>" class="text-paper/85 no-underline hover:underline"><%= deratis_email() %></a></li>
        <li>30340 Rousson</li>
        <li><a href="<%= deratis_facebook_url() %>" class="text-paper/85 no-underline hover:underline" rel="noopener">Facebook</a></li>
      </ul>
    </div>

    <div>
      <p class="mb-3 font-bold">Nos interventions</p>
      <ul class="space-y-2">
        <li><a href="<%= deratisation_path() %>" class="text-paper/85 no-underline hover:underline">Dératisation</a></li>
        <li><a href="<%= desinsectisation_path() %>" class="text-paper/85 no-underline hover:underline">Désinsectisation</a></li>
        <li><a href="<%= guepes_et_frelons_path() %>" class="text-paper/85 no-underline hover:underline">Guêpes et frelons</a></li>
        <li><a href="<%= rats_et_souris_path() %>" class="text-paper/85 no-underline hover:underline">Rats et souris</a></li>
        <li><a href="<%= articles_path() %>" class="text-paper/85 no-underline hover:underline">Conseils</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-paper/15">
    <p class="mx-auto max-w-6xl px-4 py-5 text-sm text-paper/60 sm:px-6">© Dératis, Rousson</p>
  </div>
</footer>
