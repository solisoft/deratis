<section class="border-b border-rule">
  <div class="mx-auto max-w-6xl px-4 pt-12 pb-14 sm:px-6 md:pt-16">
    <h1 class="display text-6xl sm:text-7xl lg:text-8xl">Conseils</h1>
    <p class="mt-6 max-w-2xl text-xl text-schist">Reconnaître les nuisibles, repérer les signes d'une infestation, savoir quand appeler.</p>
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <div class="divide-y divide-rule border-y border-rule">
    <% for article in @articles %>
    <article>
      <a href="<%= article_path(article["slug"]) %>" class="group grid gap-6 py-8 text-ink no-underline sm:grid-cols-[16rem_1fr] sm:items-center">
        <img src="<%= public_path("images/" + article["image"]) %>" alt="" loading="lazy" class="aspect-[4/3] w-full rounded-sm object-cover">
        <div>
          <h2 class="heading text-3xl group-hover:underline sm:text-4xl"><%- fr_text(article["title"]) %></h2>
          <p class="mt-3 max-w-xl text-lg text-schist"><%- fr_text(article["summary"]) %></p>
        </div>
      </a>
    </article>
    <% end %>
  </div>
</section>
